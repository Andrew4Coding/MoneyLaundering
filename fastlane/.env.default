# Copy to fastlane/.env and fill in. fastlane/.env is gitignored.
# Create the API key at App Store Connect → Users and Access → Integrations → App Store Connect API.

# --- App Store Connect API key (required for beta / release / metadata) ---
ASC_KEY_ID=
ASC_ISSUER_ID=
# Path to the downloaded .p8, relative to repo root (keep it OUT of git):
ASC_KEY_PATH=fastlane/AuthKey.p8
# ...or, for CI, paste the key contents (raw p8 or base64) instead of a path:
# ASC_KEY_CONTENT=

# --- Optional: Apple account / teams ---
# FASTLANE_APPLE_ID=andrewdevitoaryo@gmail.com
# FASTLANE_ITC_TEAM_ID=

# --- Optional: match (shared code signing via a private git repo) ---
# Leave MATCH_GIT_URL empty to use Xcode automatic signing instead.
# MATCH_GIT_URL=
# MATCH_PASSWORD=
